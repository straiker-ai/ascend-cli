__pycache__/
*.pyc
.venv/
venv/
.env
*.env
configs/*.json
!configs/example*.json
media/*.mov
logs/
*.log
.DS_Store
captures/
dist/
build/
*.spec

# Internal-only material (SE/engineering runbooks, customer connectivity results).
# Excluded because git HISTORY becomes public when the repo does — anything
# committed here would be permanently visible. Keep it local; share out of band.
internal/*
!internal/README.md

# Stray adapter configs at the repo root. These hold customer endpoints, tokens and
# session material. Only the shipped example-*.json templates are tracked; a config
# dropped at the root would otherwise be one `git add -A` from permanent public history.
/*.json
!pyproject.toml
*.har
# ...except the sanitized fixtures the test suite needs. The blanket rule above is right --
# a real HAR carries credentials -- but it silently swallowed tests/fixtures/*.har, so two
# tests shipped referencing files that were never committed. They passed on the machine that
# created them and failed for everyone else. These are recorded from a local demo agent with
# the host and ids normalized; test_fixtures_are_tracked.py asserts they stay credential-free.
!tests/fixtures/*.har
evidence*.json
*.egg-info/
.eggs/
*.egg
demo/*.gif
demo/*.mp4
demo/*.webm

# Stray manual-chat captures written to the repo root by --out (real prompts + replies).
/*.jsonl
runtime/debug_screenshots/

# demo recording outputs
demo/out/
*.cast
*.mp4
*.gif
*.mov
demo/*.mov

# live-matrix scratch: recorded HARs from a local forge run
.matrix/

# Internal engineering material dropped into the tree by hand — backend architecture decks,
# deep-dive slides, exported diagrams. The repo is PUBLIC and git history is public with it, so
# one `git add -A` would publish an internal architecture permanently. `internal/` above is the
# intended home for anything like this; these patterns are the safety net for the root and for
# docs/, where a deck is most likely to be dropped next to the page it explains.
*.pptx
*.ppt
*.key
*.numbers
*.pages
/architecture*.pdf
/docs/**/*.pptx
/docs/**/*.pdf
*deep-dive*
*Deep-Dive*
*ARCHITECTURE_DEEP*
